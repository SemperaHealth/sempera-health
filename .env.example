# Copy to .env.local for local development. Never commit real values.
#
# The site is currently frontend-only. If a backend/telehealth partner is added later,
# server-only secrets (e.g. its API key) go here WITHOUT the NEXT_PUBLIC_
# prefix so they are never bundled into browser code.

# Public site URL (safe to expose)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
